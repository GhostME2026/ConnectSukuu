  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy             User?              @relation("LearningSubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([learningAssignmentId, studentId])
  @@index([schoolId, studentId])
  @@index([learningAssignmentId, submittedAt])
}

