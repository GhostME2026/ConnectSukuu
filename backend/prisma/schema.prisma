  updatedAt   DateTime @updatedAt
}

model AuthOtpChallenge {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String?
  channel   String
  purpose   String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
