//ATTENDANCE ATTENDANCE
model AttendanceRecord {
  id String @id @default(cuid())

  schoolId       String
  academicYearId String
  termId         String
  classId        String
  studentId      String

  attendanceDate DateTime         @db.Date
  attendanceMode AttendanceMode
  status         AttendanceStatus

  timetableEntryId String?
  recordedById     String

  notes String?

  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school         School          @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  term           Term            @relation(fields: [termId], references: [id])
  schoolClass    SchoolClass     @relation(fields: [classId], references: [id])
  student        Student         @relation(fields: [studentId], references: [id])
  recordedBy     User            @relation(fields: [recordedById], references: [id])
  timetableEntry TimetableEntry? @relation(fields: [timetableEntryId], references: [id])

  @@unique([schoolId, dedupeKey])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([termId])
  @@index([classId])
  @@index([studentId])
  @@index([attendanceDate])
  @@index([attendanceMode])
  @@index([timetableEntryId])
  @@index([recordedById])
}

model FeePlan {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  termId         String
  classId        String
  name           String
  description    String?
  currency       String   @default("GHS")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  term         Term          @relation(fields: [termId], references: [id])
  schoolClass  SchoolClass   @relation(fields: [classId], references: [id])
  items        FeePlanItem[]
  studentFees  StudentFee[]

  @@unique([schoolId, academicYearId, termId, classId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([termId])
  @@index([classId])
  @@index([isActive])
}

model FeePlanItem {
  id          String   @id @default(cuid())
  schoolId    String
  feePlanId   String
  name        String
  code        String?
  amount      Int?
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feePlan     FeePlan      @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  studentFees StudentFee[]

  @@index([schoolId])
  @@index([feePlanId])
  @@index([sortOrder])
}

model FeeImportBatch {
  id             String    @id @default(cuid())
  schoolId       String
  academicYearId String
  termId         String
  classId        String
  fileName       String?
  format         String
  status         String    @default("PENDING")
  importedById   String
  totalRows      Int       @default(0)
  successRows    Int       @default(0)
  failedRows     Int       @default(0)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  school       School         @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  term         Term           @relation(fields: [termId], references: [id])
  schoolClass  SchoolClass    @relation(fields: [classId], references: [id])
  studentFees  StudentFee[]
  rows         FeeImportRow[]

  @@index([schoolId])
  @@index([academicYearId])
  @@index([termId])
  @@index([classId])
  @@index([importedById])
  @@index([createdAt])
}

model FeeImportRow {
  id              String   @id @default(cuid())
  importBatchId   String
  rowNumber       Int
  admissionNumber String?
  studentId       String?
  status          String   @default("PENDING")
  errorMessage    String?
  createdAt       DateTime @default(now())

  importBatch FeeImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  student     Student?       @relation(fields: [studentId], references: [id])

  @@index([importBatchId])
  @@index([studentId])
}

model PaymentAllocation {
  id           String   @id @default(cuid())
  schoolId     String
  feePaymentId String
  studentFeeId String
  amount       Int
  createdAt    DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id])
  feePayment FeePayment @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)
  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])

  @@unique([feePaymentId, studentFeeId])
  @@index([schoolId])
  @@index([feePaymentId])
  @@index([studentFeeId])
}

model GradingScale {
